<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Wine JITs x86/ARM code and maps executable memory. Without these three,
         a hardened-runtime (notarized) build crashes the moment a game runs. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-executable-page-protection</key>
    <true/>
    <!-- Wine loads its own (unsigned) dylibs and PE DLLs from the bottle. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- We set WINE*/DYLD* env vars before launching Wine. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
